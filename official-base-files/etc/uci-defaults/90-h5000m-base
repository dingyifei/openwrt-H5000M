#!/bin/sh

# Keep the official device and port definitions intact. This script only
# supplies product-level locale and management defaults.
uci -q set system.@system[0].hostname='H5000M'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q set system.@system[0].timezone='CST-8'
uci -q set luci.main.lang='zh_cn'
uci -q set network.lan.ipaddr='192.168.10.1'
uci -q set network.lan.netmask='255.255.255.0'

if [ -f /etc/config/uhttpd ]; then
	uci -q set uhttpd.main.redirect_https='1'
fi

if [ -f /etc/config/dropbear ]; then
	uci -q set dropbear.@dropbear[0].enable='1'
	uci -q set dropbear.@dropbear[0].PasswordAuth='on'
	uci -q set dropbear.@dropbear[0].RootPasswordAuth='on'
fi

if [ -x /etc/init.d/ttyd ]; then
	/etc/init.d/ttyd disable >/dev/null 2>&1 || true
fi

# Provide the requested first-boot credentials. SSH public-key login remains
# available in addition to password authentication.
if command -v chpasswd >/dev/null 2>&1; then
	echo 'root:root' | chpasswd
else
	(printf 'root\nroot\n' | passwd root) >/dev/null 2>&1 || true
fi

# Bring up both official mac80211 radios with one shared network name. Keeping
# the same SSID, security mode and key allows clients to choose the better band;
# 802.11k assists capable clients without forcing proprietary band steering.
# Do not set bss_transition here: the official compact wpad variant does not
# accept that hostapd option and would reject the entire AP configuration.
if [ -f /etc/config/wireless ]; then
	for radio in $(uci -q show wireless | sed -n 's/^\(wireless\.[^.]*\)=wifi-device$/\1/p'); do
		band="$(uci -q get "${radio}.band")"
		# AU unlocks the 5 GHz DFS band (channels 100-144) that CN blocks: measured
		# on-device, disabled 5 GHz channels drop from 16 to 7. Note this raises the
		# regulatory *ceiling* only - this unit's TX power is a confirmed no-op
		# (blank factory partition, no calibration), so expect channel choice to
		# improve, not output power. Operating region compliance is the operator's
		# responsibility.
		uci -q set "${radio}.country=AU"
		# WMM/EDCA TXOP burst (ms) for the best-effort queue -> hostapd
		# tx_queue_data2_burst. Independent of calibration, so this one can help
		# aggregate airtime efficiency.
		uci -q set "${radio}.tx_burst=2.0"
		uci -q set "${radio}.disabled=0"
		case "${band}" in
			2g)
				uci -q set "${radio}.htmode=EHT40"
				;;
			5g)
				uci -q set "${radio}.htmode=EHT160"
				;;
		esac
	done

	for iface in $(uci -q show wireless | sed -n 's/^\(wireless\.[^.]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "${iface}.mode")" = 'ap' ] || continue
		# Remove the incompatible option from preserved configurations created
		# by earlier H5000M images before hostapd reads the AP definition.
		uci -q delete "${iface}.bss_transition"
		uci -q set "${iface}.ssid=H5000M"
		uci -q set "${iface}.encryption=sae-mixed"
		uci -q set "${iface}.key=77778888"
		uci -q set "${iface}.ieee80211w=1"
		uci -q set "${iface}.ieee80211k=1"
		uci -q set "${iface}.rrm_neighbor_report=1"
		uci -q set "${iface}.rrm_beacon_report=1"
		uci -q set "${iface}.disabled=0"
	done
fi

# Forwarding performance. The vendor image reached its throughput through the
# MediaTek HNAT/WED offload, which the official mt76/mac80211 base cannot
# reproduce; these are the in-tree equivalents.
#
# packet_steering spreads network softirq work across the MT7987's 4 cores.
uci -q set network.globals.packet_steering='1'

# Flowtable offload (software + in-tree PPE hardware path).
# CAUTION: offloaded flows bypass netfilter, which can defeat fwmark-based
# policy routing. Re-validate this when mwan3 lands; if failover misroutes
# established connections, set both back to '0' - throughput is worth less
# than correct failover.
if [ -f /etc/config/firewall ]; then
	uci -q set firewall.@defaults[0].flow_offloading='1'
	uci -q set firewall.@defaults[0].flow_offloading_hw='1'
fi

uci -q commit system
uci -q commit luci
uci -q commit network
uci -q commit uhttpd
uci -q commit dropbear
uci -q commit wireless
uci -q commit firewall

exit 0
